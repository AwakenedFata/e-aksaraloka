# Aksaraloka environment variables
# Copy to `.env.local` (preferred) or `.env` and fill in values. NEVER commit real values.
# All variables are server-side only. Do NOT prefix secrets with NEXT_PUBLIC_ (that ships them to the browser).
# Full reference: docs/configuration.md

# --- Runtime ---
# debug | info | warn | error (default: info)
LOG_LEVEL=info

# --- Database (optional in Stage 0) ---
# Local dev via `npm run db:up` (docker-compose.yml, bound to 127.0.0.1 only, no auth = dev only).
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB_NAME=aksaraloka

# --- LLM providers (unused until Stage 4) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Build metadata (optional, usually injected by CI) ---
APP_COMMIT_SHA=

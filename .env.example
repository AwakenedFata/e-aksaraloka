# Aksaraloka environment variables
# Copy to `.env.local` (preferred) or `.env` and fill in values. NEVER commit real values.
# All variables are server-side only. Do NOT prefix secrets with NEXT_PUBLIC_ (that ships them to the browser).
# Full reference: docs/configuration.md

# --- Runtime ---
# debug | info | warn | error (default: info)
LOG_LEVEL=info

# --- Database (optional in Stage 0) ---
# Local dev via `npm run db:up` (docker-compose.yml, bound to 127.0.0.1 only, no auth = dev only).
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB_NAME=aksaraloka

# --- LLM providers (Hybrid Socratic Coach: Groq primary -> Gemini fallback -> Offline Layer 1) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Google Spreadsheet Integration (Primary: Google Sheets API v4 Service Account) ---
# Share target Spreadsheet to GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste private key from Service Account JSON (escape newlines as \n in single-line env)
GOOGLE_PRIVATE_KEY=
# Spreadsheet ID from https://docs.google.com/spreadsheets/d/<GOOGLE_SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=

# --- Optional Fallback: Google Apps Script Web App Webhook (if not using Service Account) ---
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# --- Panel Guru (/guru) Authentication & Deep Links ---
# PIN / sandi masuk Panel Guru (minimal 4 karakter; wajib diisi untuk mengaktifkan /guru)
TEACHER_ACCESS_CODE=
# Opsional: kunci rahasia tanda tangan cookie sesi guru (min. 16 karakter; otomatis diturunkan bila kosong)
TEACHER_SESSION_SECRET=
# URL publik aplikasi untuk tautan baca naskah dari Google Sheets (mis. https://e-aksaraloka.vercel.app)
APP_PUBLIC_URL=

# --- Build metadata (optional, usually injected by CI) ---
APP_COMMIT_SHA=
